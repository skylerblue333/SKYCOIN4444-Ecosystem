# Application Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / TiDB)
DATABASE_URL=mysql://user:password@localhost:3306/skycoin

# Authentication & JWT
JWT_SECRET=your_jwt_secret_here

# External API Integrations (Test Placeholders)
STRIPE_API_KEY=sk_test_placeholder
OPENAI_API_KEY=sk-proj-placeholder
SENDGRID_API_KEY=SG.placeholder


# Optional Enterprise Open-Source Integration Hub
# Leave unset to keep each adapter disabled. These are examples only; never
# commit production secrets to source control.

# Valkey/Redis + BullMQ
SKY_REDIS_URL=
SKY_QUEUE_PREFIX=skycoin4444

# S3-compatible object storage (for example SeaweedFS S3 gateway)
SKY_S3_ENDPOINT=
SKY_S3_REGION=us-east-1
SKY_S3_BUCKET=
SKY_S3_ACCESS_KEY_ID=
SKY_S3_SECRET_ACCESS_KEY=

# OpenSearch
SKY_OPENSEARCH_URL=
SKY_OPENSEARCH_API_KEY=
SKY_OPENSEARCH_USERNAME=
SKY_OPENSEARCH_PASSWORD=

# Qdrant
SKY_QDRANT_URL=
SKY_QDRANT_API_KEY=
SKY_QDRANT_COLLECTION=skycoin_vectors

# ClickHouse
SKY_CLICKHOUSE_URL=
SKY_CLICKHOUSE_USERNAME=
SKY_CLICKHOUSE_PASSWORD=
SKY_CLICKHOUSE_DATABASE=

# OpenTelemetry Collector OTLP/HTTP JSON endpoint, e.g. https://otel.example/v1/traces
SKY_OTEL_HTTP_ENDPOINT=

# Fluent Bit HTTP input endpoint
SKY_FLUENTBIT_HTTP_ENDPOINT=

# Flagsmith
SKY_FLAGSMITH_URL=
SKY_FLAGSMITH_ENVIRONMENT_KEY=

# Keycloak OIDC issuer, e.g. https://id.example/realms/skycoin
SKY_KEYCLOAK_ISSUER=
SKY_KEYCLOAK_AUDIENCE=

# Kong Admin API
SKY_KONG_ADMIN_URL=
SKY_KONG_ADMIN_TOKEN=
